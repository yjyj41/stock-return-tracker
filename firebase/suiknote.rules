// 수익노트 — add this block inside `match /databases/{database}/documents { ... }`
// of the existing bullet-journal-b359c Firestore rules (Firebase console → Firestore → Rules).
// Keep the journal's existing rules as they are; this only opens suiknote/{uid} to its owner.
match /suiknote/{uid} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
  match /parts/{part} {
    allow read, write: if request.auth != null && request.auth.uid == uid;
  }
}
